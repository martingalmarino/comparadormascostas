# URL pública, con protocolo. Todavía no hay dominio: dejá localhost en desarrollo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hola@example.com

# Publicidad. El script de AdSense solo se carga con consentimiento.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Analytics. GA4 solo se carga si la persona acepta el banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Opcional. Si definís el secreto, el formulario exige el token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Guardado de leads. Hace falta al menos uno en producción.
# En local, si no hay nada, se escribe .data/leads.jsonl
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LEADS_WEBHOOK_URL=

# Aviso por email (Resend)
RESEND_API_KEY=
RESEND_FROM=
LEADS_NOTIFY_EMAIL=

# Reservado si más adelante se llama un cron propio. La vía prevista es el workflow de GitHub.
CRON_SECRET=
